# Frontend env (IMPLEMENTATION §1). Copy to .env.local; all VITE_* are public.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
# Maps JavaScript API browser key for the §13.2 map surfaces. MUST be a
# separate, HTTP-referrer-restricted key — never the worker's server-side
# GOOGLE_MAPS_API_KEY, since every VITE_* value ships to the browser.
# Unset: map surfaces render an explanatory placeholder; nothing else breaks.
VITE_GOOGLE_MAPS_API_KEY=
