# Phase 0 run persistence (worker/src/manzil_worker/persistence.py)
.manzil/

archive/

# Bench/eval kit — local eval assets, never repo content (DESIGN §20 v2.8).
# Scraped listing pages are copyrighted third-party content with embedded
# vendor keys/tracking IDs; the hand labels are ground truth about those
# local snapshots and travel with them. Only .gitkeep placeholders are
# tracked so a fresh clone still has the directories. bench/manifest.md
# (methodology, no page content) stays tracked. BACK THE KIT UP — hostile
# pages and delisted listings cannot be re-fetched (IMPLEMENTATION §8).
worker/tests/fixtures/corpus/*
!worker/tests/fixtures/corpus/.gitkeep
worker/tests/fixtures/bench/labels/*
!worker/tests/fixtures/bench/labels/.gitkeep

# Record-mode artifacts are keyed to local corpus content (and carry page
# evidence quotes) — only the smoke replay fixture is repo content. When
# Phase 1 dev-seed needs committed recordings for the synthetic pages,
# un-ignore those specific hashes here.
worker/tests/fixtures/recorded/*
!worker/tests/fixtures/recorded/.gitkeep
!worker/tests/fixtures/recorded/smoke--*.json
# P1-1 dev-seed replay fixtures for the committed synthetic pages
# (e2e_listing / success_text / injection_listing; validate+extract+verify each).
# These are repo content, so committing them is repo-safe (DESIGN §20 v2.8
# excludes only corpus-keyed artifacts). Per-file, keyed by content hash.
# Re-keyed 2026-08-17 when VALIDATE moved to the Luna lightweight pin. The
# three `extract--{5c2ab4,e4eff3,2ffad8}` files below are the older
# haiku-keyed ones `_SEED_EXTRACT_RECORDINGS` still loads *by filename* to pin
# legacy seed EXTRACT output in tests — they are not replayed by hash.
!worker/tests/fixtures/recorded/validate--39eb37d82e879e1b.json
!worker/tests/fixtures/recorded/validate--482657b9108bedbb.json
!worker/tests/fixtures/recorded/validate--959339453b9737e9.json
!worker/tests/fixtures/recorded/extract--33e30ecc6fba22ad.json
!worker/tests/fixtures/recorded/extract--6cf6960a7fed2628.json
!worker/tests/fixtures/recorded/extract--ca4dcd118e550d26.json
!worker/tests/fixtures/recorded/verify--620a92c4036818de.json
!worker/tests/fixtures/recorded/verify--a0d0b1a2d399cda0.json
!worker/tests/fixtures/recorded/verify--d33440fb273381e7.json
# Legacy filename-pinned seed EXTRACT outputs (see above).
!worker/tests/fixtures/recorded/extract--5c2ab4abc7ec5991.json
!worker/tests/fixtures/recorded/extract--e4eff37208aec8e0.json
!worker/tests/fixtures/recorded/extract--2ffad86017282b67.json

# Bench reports are keyed to the gitignored local eval kit (corpus + labels)
# and carry page evidence quotes — local artifacts, never repo content.
worker/evals/reports/
# P3-7 local originals and human image-label kit. Normalized approved anchors,
# generated reference sheets, and their manifest are the only committed assets.
worker/prompts/vision_refs/originals/
worker/tests/fixtures/vision_labels/
# Public pretrained model/dataset downloads for the local discriminative-vision
# benchmark. The reproducible manifest, loaders, metrics, and reports belong in
# source control; third-party weights and images do not.
worker/tests/fixtures/vision_benchmark/
.pnpm-store/**
worker/tests/fixtures/bench/labels.md

docs/screenshots/**
.playwright-mcp/**

graphify-out/
