#!/usr/bin/env bash
# Manzil dev launcher — Supabase check/start + API + frontend in a tmux session.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION=manzil
SUPABASE_PG_PORT=54322

cd "$ROOT"

usage() {
  cat <<'EOF'
Usage: scripts/dev [command]

Commands:
  (none)   Ensure Supabase is up, then start or attach the dev tmux session
  kill     Stop the dev tmux session (Supabase keeps running)
  status   Show Supabase and tmux session status
EOF
}

require_tmux() {
  if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is not installed. Install it with: brew install tmux" >&2
    exit 1
  fi
}

require_docker() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is not running. Start Docker Desktop, then retry." >&2
    exit 1
  fi
}

_env_var_empty() {
  local name="$1"
  local file="$2"
  [[ ! -f "$file" ]] && return 0
  local line
  line="$(grep -E "^${name}=" "$file" 2>/dev/null | tail -1 || true)"
  [[ -z "$line" ]] && return 0
  local value="${line#*=}"
  value="${value%\"}"
  value="${value#\"}"
  value="${value%\'}"
  value="${value#\'}"
  [[ -z "${value//[[:space:]]/}" ]]
}

warn_missing_env() {
  if [[ ! -f "$ROOT/.env" ]]; then
    echo "Warning: $ROOT/.env not found. Copy infra/.env.example to .env and fill in keys." >&2
    return
  fi
  local missing=()
  _env_var_empty SUPABASE_ANON_KEY "$ROOT/.env" && missing+=(SUPABASE_ANON_KEY)
  _env_var_empty SUPABASE_SECRET_KEY "$ROOT/.env" && missing+=(SUPABASE_SECRET_KEY)
  if ((${#missing[@]} > 0)); then
    echo "Warning: .env is missing values for: ${missing[*]}" >&2
    echo "  Run: supabase status -o env" >&2
    echo "  Then copy ANON_KEY -> SUPABASE_ANON_KEY and SERVICE_ROLE_KEY -> SUPABASE_SECRET_KEY" >&2
    echo "  Authenticated API calls will 500 (browser reports this as a CORS error) until set." >&2
  fi
  if [[ ! -f "$ROOT/frontend/.env.local" ]]; then
    echo "Warning: frontend/.env.local not found. Copy frontend/.env.example and set VITE_SUPABASE_* keys." >&2
  elif _env_var_empty VITE_SUPABASE_ANON_KEY "$ROOT/frontend/.env.local"; then
    echo "Warning: frontend/.env.local has empty VITE_SUPABASE_ANON_KEY — auth will not work." >&2
  fi
}

supabase_up() {
  nc -z 127.0.0.1 "$SUPABASE_PG_PORT" 2>/dev/null
}

ensure_supabase() {
  if supabase_up; then
    return 0
  fi
  echo "Supabase is not running. Starting local stack..."
  require_docker
  supabase start
}

cmd_status() {
  if supabase_up; then
    echo "supabase: up (postgres on 127.0.0.1:$SUPABASE_PG_PORT)"
  else
    echo "supabase: down"
  fi
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "tmux: session '$SESSION' running"
  else
    echo "tmux: session '$SESSION' not running"
  fi
}

cmd_kill() {
  require_tmux
  if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
    echo "Stopped tmux session '$SESSION'."
  else
    echo "No tmux session '$SESSION' to stop."
  fi
}

start_or_attach_session() {
  require_tmux

  if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach -t "$SESSION"
  fi

  tmux new-session -d -s "$SESSION" -n dev \
    "uv run --package manzil-api uvicorn manzil_api.main:app --reload --port 8000"
  tmux split-window -h -t "$SESSION:dev" \
    "pnpm -C frontend dev"
  tmux set-option -t "$SESSION" remain-on-exit on
  tmux select-pane -t "$SESSION:dev.0"
  exec tmux attach -t "$SESSION"
}

cmd_start() {
  warn_missing_env
  ensure_supabase
  start_or_attach_session
}

case "${1:-}" in
  "")
    cmd_start
    ;;
  kill)
    cmd_kill
    ;;
  status)
    cmd_status
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
