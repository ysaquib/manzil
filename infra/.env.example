# Manzil environment (IMPLEMENTATION.md §1). Copy to .env; never commit real values.

# worker
OPENROUTER_API_KEY=
# OpenRouter app attribution — https://openrouter.ai/docs/app-attribution
# Production: https://manzil.yusufsaquib.com (falls back to MANZIL_FRONTEND_URL)
# OPENROUTER_HTTP_REFERER=https://manzil.yusufsaquib.com
# OPENROUTER_APP_TITLE=Manzil

# worker — wired before the first LLM call (NFR6); the API gets no Langfuse keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# worker, api — direct Postgres (worker uses service-level access)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# frontend, api — anon key is RLS-safe by design
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# worker — and, from Phase 1, the api's in-process worker loop (P1-3). Never in
# frontend env.
SUPABASE_SECRET_KEY=

# api — in-process worker loop toggle (DESIGN §5 default). Set `false` only after
# a separate worker process is deployed and validated per IMPLEMENTATION §8.
MANZIL_WORKER_INPROCESS=true

# api — frontend dev origin(s), comma-separated (CORS)
API_CORS_ORIGINS=http://localhost:5173
MANZIL_FRONTEND_URL=http://localhost:5173

# api — local | staging | production; gates OpenAPI docs exposure
API_ENVIRONMENT=local

# api — P3-22 product/Hunt mail. Authentication and security mail remains in
# Supabase Auth's separately configured SMTP path. `resend` is required in
# production; `disabled` is the safe local default.
MANZIL_EMAIL_MODE=disabled
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MANZIL_MAIL_FROM=alerts@example.com
MANZIL_MAIL_FROM_NAME=Manzil

# frontend (Vite) — all public, RLS-safe by design. Copy into frontend/.env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# worker — tier-3 managed unblocker (FREE PLANS ONLY, §20 2026-07-07).
# Provider: brightdata (default) | scrapingbee — set MANZIL_TIER3_PROVIDER to switch.
# MANZIL_TIER3_FALLBACK_PROVIDER is optional decode-failure recovery only. It
# must name a distinct, fully configured provider; leave it empty until the
# provider account and its plan allowance have been verified.
# Tier 3 stays off the fetch ladder until EVERY setting below is present; a key
# with no zone is not a working tier 3, it is an HTTP 400 per request.
#
# BRIGHTDATA_ZONE is the **zone** name from Bright Data's control panel (Proxies
# & Scraping Infrastructure), NOT the name of the API key shown next to it —
# they differ per environment, and sending the key's name 400s every request
# (§20 2026-08-11). BRIGHTDATA_KEY_NAME is accepted as an alias for the same
# value. There is no default: an empty value here means "tier 3 is off".
MANZIL_TIER3_PROVIDER=brightdata
MANZIL_TIER3_FALLBACK_PROVIDER=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=
SCRAPINGBEE_API_KEY=

# worker — Phase 3
GOOGLE_MAPS_API_KEY=

# worker: workflow (default) | agents
MANZIL_MODE=workflow

# worker/api — unused on the workflow path (DESIGN v3.102). Leave unset on
# Render starter so the CLIP ONNX subprocess is never constructed. The factory
# `_configured_image_classify_onnx` still reads this for a possible revert.
# MANZIL_IMAGE_CLASSIFY_ONNX_DIR=/absolute/path/to/clip-vision-onnx-uint8

# worker, tests: live | record | replay (IMPLEMENTATION.md §5)
MANZIL_LLM_MODE=live
